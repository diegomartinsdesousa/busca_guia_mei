INFOSIMPLES_TOKEN=seu_token_infosimples
DOWNLOAD_DIR=./downloads
PORT=3000

# Evita codigo 609 (limite no site da Receita): pausa entre cada mes e retentativas
DELAY_ENTRE_PERIODOS_MS=10000
# Segundos (parametro da API). Evite 300 em producao (cada chamada pode demorar ate esse limite).
INFOSIMPLES_TIMEOUT=120
# Timeout ao baixar paginas/PDF da Receita (ms)
DOWNLOAD_FETCH_TIMEOUT_MS=120000
# Tempo maximo da requisicao HTTP no Node (ms) — lotes com muitos meses
SERVER_REQUEST_TIMEOUT_MS=900000
INFOSIMPLES_MAX_RETRIES_609=2
INFOSIMPLES_RETRY_DELAY_609_MS=25000

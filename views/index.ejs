<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gerador DAS MEI</title>
    <link rel="stylesheet" href="/style.css?v=20260422" />
    <style>
      /* Fallback caso o CSS externo falhe em produção */
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f4f6f8;
        color: #1f2937;
      }
      .container {
        max-width: 720px;
        margin: 40px auto;
        padding: 24px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      }
      form {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      input, button, select {
        font-size: 15px;
        padding: 10px 12px;
        border-radius: 8px;
      }
      input, select {
        border: 1px solid #d1d5db;
      }
      button, .botao-link {
        border: 0;
        background: #2563eb;
        color: #fff;
        font-weight: 700;
        cursor: pointer;
        margin-top: 8px;
        text-decoration: none;
        display: inline-block;
      }
      .overlay-processando {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
      }
      .overlay-processando[hidden] {
        display: none !important;
      }
      .overlay-conteudo {
        background: #fff;
        padding: 24px 28px;
        border-radius: 12px;
        max-width: 360px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
      }
      .overlay-dica {
        font-size: 14px;
        color: #4b5563;
        margin: 8px 0 0;
      }
      .dica-ano {
        font-size: 14px;
        color: #6b7280;
        margin: 0 0 12px;
      }
    </style>
  </head>
  <body>
    <main class="container">
      <h1>Gerador DAS MEI (mes a mes)</h1>
      <p>
        Integracao via API da InfoSimples para consulta do DAS mes a mes.
      </p>
      <p class="dica-ano">
        Use ano e meses ja disponiveis na Receita. Periodos muito futuros podem demorar ou falhar.
      </p>

      <nav class="menu-topo">
        <a href="/" class="botao-link">Tela principal</a>
        <a href="/configuracoes" class="botao-link">Configuracoes</a>
      </nav>

      <% if (erro) { %>
      <div class="alerta erro"><%= erro %></div>
      <% } %>

      <% if (mensagem) { %>
      <div class="alerta ok"><%= mensagem %></div>
      <% } %>

      <% if (tela === "configuracoes") { %>
      <section class="processo">
        <h2>Configuracoes</h2>
        <form action="/configuracoes" method="post">
          <label for="tokenInfosimples">Token InfoSimples</label>
          <input
            id="tokenInfosimples"
            name="tokenInfosimples"
            type="password"
            placeholder="seu_token_aqui"
            value="<%= valores.tokenInfosimples %>"
            required
          />

          <label for="diretorioDownload">Pasta de download</label>
          <input
            id="diretorioDownload"
            name="diretorioDownload"
            type="password"
            placeholder="C:\caminho\downloads"
            value="<%= valores.diretorioDownload %>"
            required
          />

          <button type="submit" class="botao-secundario">Salvar configuracoes</button>
          <a href="/" class="botao-link">Voltar para tela principal</a>
        </form>
      </section>
      <% } else { %>
      <div id="overlayProcessando" class="overlay-processando" hidden aria-live="polite">
        <div class="overlay-conteudo">
          <p><strong>Processando...</strong></p>
          <p class="overlay-dica">A consulta pode levar 1 a 3 minutos por mes (API + Receita). Nao feche esta aba.</p>
        </div>
      </div>
      <form id="formConsulta" action="/gerar" method="post">
        <label for="cnpj">CNPJ</label>
        <input
          id="cnpj"
          name="cnpj"
          placeholder="00.000.000/0000-00"
          value="<%= valores.cnpj %>"
          required
        />

        <label for="ano">Ano</label>
        <select id="ano" name="ano" required>
          <% for (let ano = new Date().getFullYear() - 5; ano <= new Date().getFullYear() + 1; ano++) { %>
          <option value="<%= ano %>" <%= String(ano) === String(valores.ano) ? "selected" : "" %>>
            <%= ano %>
          </option>
          <% } %>
        </select>

        <fieldset class="meses-fieldset">
          <legend>Meses</legend>
          <label class="mes-opcao selecionar-todos">
            <input type="checkbox" id="selecionarTodosMeses" />
            <span>Selecionar todos</span>
          </label>
          <div class="meses-grid">
            <% const meses = [
              { valor: "01", nome: "Janeiro" },
              { valor: "02", nome: "Fevereiro" },
              { valor: "03", nome: "Marco" },
              { valor: "04", nome: "Abril" },
              { valor: "05", nome: "Maio" },
              { valor: "06", nome: "Junho" },
              { valor: "07", nome: "Julho" },
              { valor: "08", nome: "Agosto" },
              { valor: "09", nome: "Setembro" },
              { valor: "10", nome: "Outubro" },
              { valor: "11", nome: "Novembro" },
              { valor: "12", nome: "Dezembro" }
            ]; %>
            <% meses.forEach((mes) => { %>
            <label class="mes-opcao">
              <input
                type="checkbox"
                name="mesesSelecionados"
                value="<%= mes.valor %>"
                <%= valores.mesesSelecionados?.includes(mes.valor) ? "checked" : "" %>
              />
              <span><%= mes.nome %></span>
            </label>
            <% }); %>
          </div>
        </fieldset>

        <label for="dataPagamento">Data de pagamento (opcional)</label>
        <input
          id="dataPagamento"
          name="dataPagamento"
          placeholder="AAAA-MM-DD"
          value="<%= valores.dataPagamento %>"
        />

        <button type="submit" id="btnConsultar">Consultar via InfoSimples</button>
      </form>

      <% if (logs?.length) { %>
      <section class="processo">
        <h2>Logs da execucao</h2>
        <ul class="lista-meses">
          <% logs.forEach((log) => { %>
          <li class="item-mes"><%= log %></li>
          <% }) %>
        </ul>
      </section>
      <% } %>

      <% if (resultados?.length) { %>
      <section class="processo">
        <h2>Resultados por periodo</h2>
        <ul class="lista-meses">
          <% resultados.forEach((item) => { %>
          <li class="item-mes <%= item.sucesso ? 'baixado' : '' %>">
            <div class="item-topo">
              <strong><%= item.periodo %></strong>
              <span class="status">code <%= item.code %></span>
            </div>
            <% if (item.sucesso) { %>
            <small>PDF salvo com sucesso.</small>
            <% if (item.linksDownload?.length) { %>
            <% item.linksDownload.forEach((arquivo) => { %>
            <small><a href="<%= arquivo.url %>">Baixar PDF: <%= arquivo.nome %></a></small>
            <% }) %>
            <% } %>
            <% } else { %>
            <small><%= item.codeMessage || "Falha na consulta." %></small>
            <% if (item.errors?.length) { %>
            <small>Detalhe: <%= item.errors.join("; ") %></small>
            <% } %>
            <% } %>
          </li>
          <% }) %>
        </ul>
      </section>
      <% } %>
      <% } %>
    </main>
    <script>
      (function () {
        const toggleTodos = document.getElementById("selecionarTodosMeses");
        const checkboxesMeses = Array.from(
          document.querySelectorAll('input[name="mesesSelecionados"]')
        );

        if (!toggleTodos || checkboxesMeses.length === 0) return;

        const sincronizarToggleTodos = function () {
          toggleTodos.checked = checkboxesMeses.every((checkbox) => checkbox.checked);
        };

        toggleTodos.addEventListener("change", function () {
          checkboxesMeses.forEach((checkbox) => {
            checkbox.checked = toggleTodos.checked;
          });
        });

        checkboxesMeses.forEach((checkbox) => {
          checkbox.addEventListener("change", sincronizarToggleTodos);
        });

        sincronizarToggleTodos();
      })();

      (function () {
        const form = document.getElementById("formConsulta");
        const overlay = document.getElementById("overlayProcessando");
        const btn = document.getElementById("btnConsultar");
        if (!form || !overlay) return;
        form.addEventListener("submit", function () {
          overlay.hidden = false;
          if (btn) {
            btn.disabled = true;
            btn.textContent = "Aguarde...";
          }
        });
      })();
    </script>
  </body>
</html>
